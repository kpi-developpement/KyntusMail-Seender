# Copier ce fichier en « .env » à la racine et y mettre les vraies valeurs.
# Le fichier .env est ignoré par git : aucun secret ne doit retourner dans le dépôt.

# --- Base de données ---
SPRING_DATASOURCE_URL=jdbc:postgresql://10.10.10.50:5432/mailingdb?reWriteBatchedInserts=true
SPRING_DATASOURCE_USERNAME=kyntus_user
SPRING_DATASOURCE_PASSWORD=change-me

# --- SMTP (IONOS) ---
MAIL_HOST=smtp.ionos.fr
MAIL_PORT=587
MAIL_USERNAME=communication.bytel@kyntus.com
MAIL_PASSWORD=change-me
MAIL_FROM_NAME=Kyntus
# Adresse de réponse (vide = identique à MAIL_USERNAME)
MAIL_REPLY_TO=
# Adresse de désinscription publiée dans l'entête List-Unsubscribe (vide = entête omise)
MAIL_UNSUBSCRIBE=

# --- Copie par défaut sur tous les envois ---
MAIL_DEFAULT_CC=zouheir.belhouji@kyntus.com

# --- Rythme d'envoi (anti-ban) ---
MAIL_MAX_PER_HOUR=60
MAIL_MIN_DELAY_MS=20000
MAIL_MAX_DELAY_MS=45000
MAIL_MAX_ATTEMPTS=3

# --- Origines autorisées à appeler l'API ---
KYNTUS_CORS_ALLOWED_ORIGINS=http://10.10.10.25:1193,http://localhost:1193
